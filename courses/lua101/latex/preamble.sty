% LUA101's shared preamble for LaTeX documents, built with latexmk -lualatex.
% Load it after the document class with \usepackage{preamble}. The latexmkrc beside
% each document adds this folder to TEXINPUTS, so LaTeX finds it and macros.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/11/23 LUA101 shared preamble]

\RequirePackage{fontspec}
\RequirePackage{amsmath}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage[hidelinks]{hyperref}

% Lua code. The listings package defines Lua up to 5.3, which covers the syntax the
% exams use; the extra keywords add Lua 5.4's variable attributes and goto.
\lstdefinestyle{lua}{
  language={[5.3]Lua},
  morekeywords={goto},
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries,
  commentstyle=\itshape\color{black!70},
  stringstyle=\color{black!85},
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  upquote=true,
  literate={<const>}{{\textless const\textgreater}}7 {<close>}{{\textless close\textgreater}}7,
}
\lstset{style=lua}

% Inline Lua: \code|local x = 1|. \code reads its code verbatim, between two copies of a
% character that the code doesn't contain, so that %, #, and braces in Lua code need no escapes.
% Like \verb, it can't be used inside the argument of another command.
\newcommand{\code}{\lstinline[style=lua]}

\input{macros.tex}
