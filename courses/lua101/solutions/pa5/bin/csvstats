#!/usr/bin/env lua
-- csvstats FILE.csv: prints statistics for each column of a CSV file.

local csvstats = require("csvstats")

if #arg ~= 1 then
  io.stderr:write("usage: csvstats FILE.csv\n")
  os.exit(2)
end

local header, rows = csvstats.read(arg[1])
if header == nil then
  io.stderr:write("csvstats: ", rows, "\n")
  os.exit(1)
end
print(csvstats.format(csvstats.analyze(header, rows)))
